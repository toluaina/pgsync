# syntax=docker/dockerfile:1.7

# Build wheels in an isolated stage, so compiler tooling and source files do not
# become part of the published image.
FROM python:3.12.12-slim AS build

WORKDIR /app

# Build dependency wheels first for better layer reuse. All current
# dependencies, including psycopg2-binary, publish compatible wheels.
COPY requirements/base.txt ./requirements/base.txt
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r requirements/base.txt

COPY pgsync/ ./pgsync/
COPY README.rst LICENSE setup.cfg setup.py ./
COPY bin/bootstrap bin/parallel_sync bin/pgsync ./bin/
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /wheels .

FROM python:3.12.12-slim AS runtime

WORKDIR /app

# Install as root, then run the CLI without root privileges. Creating this
# directory with the runtime user's ownership also initializes a fresh named
# Docker volume with permissions suitable for file checkpoints.
RUN useradd --no-create-home --shell /bin/false pgsync \
    && install -d -o pgsync -g pgsync /app/checkpoints
RUN --mount=type=bind,from=build,source=/wheels,target=/wheels,readonly \
    pip install --no-cache-dir --no-index --find-links=/wheels /wheels/pgsync-*.whl

USER pgsync

# Entrypoint matches pgsync CLI behavior.
ENTRYPOINT ["pgsync"]
